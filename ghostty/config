# Shared settings. Platform-specific ones live in the file included at the
# bottom; install.sh links the right one to ~/.config/ghostty/platform.

font-size = 12
background = #121212
theme = Tomorrow Night Bright

# Don't dim unfocused splits; 1 = no fade. Since nothing fades, the divider
# is the only cue for where one split ends, so make it clearly visible.
unfocused-split-opacity = 1
split-divider-color = #7a7a7a

cursor-style = block
# Shell integration forces a bar cursor at the prompt, which overrides
# cursor-style. no-cursor turns that off so block actually sticks.
shell-integration-features = no-cursor

# Close tabs/windows without the "a process is still running" prompt.
confirm-close-surface = false

# Ghostty treats `cmd` as an alias for `super`, and a Keychron in Mac mode
# sends the same keycode for both, so these are identical on macOS and Pop!_OS.
# iTerm2 muscle memory: cmd+r is Reset there, not Clear Buffer.
keybind = super+shift+r=reload_config
keybind = super+l=clear_screen

# Only the font and window chrome actually differ per platform. The ? makes
# this optional, so a machine with no platform file still starts.
config-file = ?platform

# Resize splits faster
keybind = super+ctrl+left=resize_split:left,50
keybind = super+ctrl+right=resize_split:right,50
keybind = super+ctrl+up=resize_split:up,50
keybind = super+ctrl+down=resize_split:down,50

