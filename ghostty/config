#
# The template does not set any default options, since Ghostty ships
# with sensible defaults for all options. Users should only need to set
# options that they want to change from the default.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#
# Ghostty can reload the configuration while running by using the menu
# options or the bound key (default: Command + Shift + comma on macOS and
# Control + Shift + comma on other platforms). Not all config options can be
# reloaded while running; some only apply to new windows and others may require
# a full restart to take effect.

# Shared settings. Platform-specific ones live in the file included at the
# bottom; install.sh links the right one to ~/.config/ghostty/platform.

background = #121212
theme = Tomorrow Night Bright

# Don't dim unfocused splits (1 = no fade); the divider color below is the
# only remaining cue for where a split ends.
unfocused-split-opacity = 1
split-divider-color = #7a7a7a

cursor-style = block
# no-cursor, or shell integration overrides cursor-style.
shell-integration-features = no-cursor

# Close tabs/windows without the "a process is still running" prompt.
confirm-close-surface = false

# cmd+W closes the focused split, not the whole tab.
keybind = ctrl+shift+w=close_surface

# `cmd` = `super`, so these work on macOS and Linux.
keybind = super+shift+r=reload_config
keybind = super+l=clear_screen

# The ? makes this optional, so a machine with no platform file still starts.
config-file = ?platform

# Equalize after every split so panes stay even.
keybind = super+d=new_split:right
keybind = chain=equalize_splits
keybind = super+shift+d=new_split:down
keybind = chain=equalize_splits

# Closing a split can't auto-equalize (the chained action dies with the
# surface), so keep it on an easy key. Default is super+ctrl+=.
keybind = super+r=equalize_splits

# Navigate splits. super+[/] are the macOS defaults; on Linux the defaults
# are super+ctrl+[/], so bind them explicitly to keep one set of keys.
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next

# Resize splits faster
keybind = super+ctrl+left=resize_split:left,50
keybind = super+ctrl+right=resize_split:right,50
keybind = super+ctrl+up=resize_split:up,50
keybind = super+ctrl+down=resize_split:down,50
