[core]
	excludesfile = ~/.gitignore
	whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
	trustctime = false

[user]
	name = Erick Yellott
	email = erick.yellott@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	st = status
	br = branch
	co = checkout
	up = fetch origin master:master
	staged = diff --cached
	ignored = ls-files -o -i --exclude-standard

[push]
	default = simple

[pull]
	rebase = true

[pager]
	branch = false

[merge]
	tool = zed

[credential]
	helper = osxkeychain

[init]
	defaultBranch = master

[commit]
	gpgsign = true

[gpg]
	format = ssh
