[core]
	excludesfile = ~/.gitignore
	whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
	trustctime = false

[user]
	name = Erick Yellott
	email = erick.yellott@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	st = status
	br = branch
	co = checkout
	up = fetch origin master:master
	staged = diff --cached
	ignored = ls-files -o -i --exclude-standard

[push]
	default = simple

[pull]
	rebase = true

[pager]
	branch = false

[merge]
	tool = zed

[credential]
	helper = osxkeychain

[init]
	defaultBranch = master

[commit]
	gpgsign = true

[gpg]
	format = ssh

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Work machines override the email above. install.sh links git/gitconfig.work
# here when ~/.config/dotfiles/profile says `work`, and removes it otherwise.
# Later includes win, and git ignores the include silently when absent.
[include]
	path = ~/.gitconfig.local
